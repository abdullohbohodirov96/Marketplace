# ============================================================================
# Malika Market — environment variables
# Copy to .env.local (dev) and set the same keys in Vercel Project Settings
# for preview/production. Never commit an actual .env / .env.local file.
# ============================================================================

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client / prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for `npm run db:migrate` / `npm run db:seed` (plain Postgres
# connection string) — Project Settings -> Database -> Connection string
# (URI). Not needed if you apply migrations via `npx supabase db push`
# or psql directly (see README).
DATABASE_URL=

# --- Cron ------------------------------------------------------------------
# Random long secret. Vercel Cron sends it as a Bearer token; every
# src/app/api/cron/* route must verify it before doing any work.
CRON_SECRET=

# --- IMEI hashing --------------------------------------------------------
# Server-only pepper for hashing used-phone IMEIs (HMAC-SHA256) before they
# ever reach the database — see src/lib/utils/imei.ts. Required for
# "Ishlatilgan telefon qo'shish" (used-device listing) to accept an IMEI.
# Generate with: openssl rand -hex 32
IMEI_HASH_SECRET=

# --- Map ---------------------------------------------------------------
# OpenStreetMap tile server. The public demo tile server below is fine for
# development but is rate-limited and not for production — see README.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Email (Stage 7+) -------------------------------------------------------
RESEND_API_KEY=

# --- Telegram bot (Stage 7+) -------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Rate limiting ---------------------------------------------------------
# Without these, rate limiting silently falls back to per-instance in-memory
# storage — fine for local dev, NOT safe once the app runs on more than one
# server instance in production. Create a free Redis database at
# https://console.upstash.com (REST API, not the Redis protocol) and copy
# its REST URL + token here and into Render's Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
